# Duck Agent Configuration
#
# Duck-Agent is a local-first agent. Grok Build is the primary harness (see
# AGENTS.md). This file documents the supported runtime knobs; secrets live in
# ~/.duck-agent/.env (mode 600) and are written by `duck-agent setup`.

# ---------------------------------------------------------------------------
# Harness selection
# ---------------------------------------------------------------------------
# grok-build (primary, default) | prime-agent | duck-agent-compatible
DUCK_AGENT_BACKEND=grok-build

# The installed Grok Build binary used by `duck-agent chat` / `duck-agent work`.
# Normally auto-detected on PATH; set to an explicit path if grok isn't on PATH.
GROK_BIN=

# xAI Grok Build API key. Prefer `duck-agent setup` (writes ~/.duck-agent/.env,
# never committed). Can also be supplied here or via DUCK_AGENT_HOME/.env.
GROK_API_KEY=your_grok_api_key_here

# ---------------------------------------------------------------------------
# State / isolation
# ---------------------------------------------------------------------------
# Optional override of the isolated state directory.
# Defaults: ~/.duck-agent (Linux/macOS) or %LOCALAPPDATA%\duck-agent (Windows).
# Duck-Agent NEVER uses ~/.hermes; that directory belongs to a separate Hermes
# install and is left untouched.
# DUCK_AGENT_HOME=/absolute/path/to/duck-agent-home

# ---------------------------------------------------------------------------
# Non-primary harnesses (only when DUCK_AGENT_BACKEND is not grok-build)
# ---------------------------------------------------------------------------
# Prime Agent (RLM-based) settings
PRIME_AGENT_MODEL=anthropic/claude-sonnet-4-20250514
PRIME_AGENT_API_KEY=your_prime_api_key_here

# duck-agent-compatible settings
HERMES_MODEL=anthropic/claude-sonnet-4-20250514
HERMES_API_KEY=your_hermes_api_key_here

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO