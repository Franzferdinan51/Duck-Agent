# Duck Agent Configuration

# Backend selection: grok-build (default), hermes-compatible, prime-agent
DUCK_AGENT_BACKEND=grok-build

# Grok Build Configuration
GROK_API_KEY=your_grok_api_key_here

# Hermes-compatible mode settings (when using hermes-compatible backend)
HERMES_MODEL=anthropic/claude-sonnet-4-20250514
HERMES_API_KEY=your_hermes_api_key_here

# Prime Agent settings (when using prime-agent backend)
PRIME_AGENT_MODEL=anthropic/claude-sonnet-4-20250514
PRIME_AGENT_API_KEY=your_prime_api_key_here

# General settings
LOG_LEVEL=INFO
