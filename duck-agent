#!/bin/bash
# Duck Agent Launcher
# A self-improving AI agent powered by Grok Build
#
# Usage:
#   ./duck-agent [options]
#   DUCK_AGENT_BACKEND=grok-build ./duck-agent
#
# Environment Variables:
#   DUCK_AGENT_BACKEND   - Backend to use: grok-build, hermes-compatible, prime-agent
#   GROK_API_KEY         - Grok API key for Grok Build backend
#   GROK_MODEL           - Model to use (default: grok-3)

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="${DUCK_AGENT_BACKEND:-grok-build}"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Handle help and status flags
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo -e "${GREEN}Duck Agent${NC} - Powered by Grok Build"
    echo ""
    echo "Usage: duck-agent [options]"
    echo ""
    echo "Options:"
    echo "  --help, -h     Show this help message"
    echo "  --version, -v  Show version information"
    echo "  --status       Show current backend status"
    echo "  --backends     List available backends"
    echo ""
    echo "Environment Variables:"
    echo "  DUCK_AGENT_BACKEND   Backend to use (default: grok-build)"
    echo "  GROK_API_KEY         Grok API key for Grok Build backend"
    echo "  GROK_MODEL           Model to use (default: grok-3)"
    echo ""
    echo "Available backends:"
    echo "  grok-build         Primary harness with full Grok Build capabilities"
    echo "  hermes-compatible  Hermes Agent compatibility mode"
    echo "  prime-agent        Prime Intellect RLM-based agent"
    exit 0
fi

if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
    cd "$SCRIPT_DIR"
    exec python3 -m duck_agent.cli --version
fi

if [ "$1" = "--backends" ]; then
    cd "$SCRIPT_DIR"
    exec python3 -m duck_agent.cli backends
fi

if [ "$1" = "--status" ]; then
    cd "$SCRIPT_DIR"
    exec python3 -m duck_agent.cli status
fi

# Normal launch
echo -e "${GREEN}Duck Agent${NC} - Powered by Grok Build"
echo -e "Backend: ${YELLOW}$BACKEND${NC}"
echo ""

# Duck-Agent command surface: run through duck_agent.cli (the real CLI with
# status/work/update/setup/backends/workflows/capabilities/doctor/chat).
# If $1 is a known command, delegate; otherwise fall through to the backend
# wrapper (interactive launch / positional prompt). Run as a module from the
# repo root so ``duck_agent`` resolves as a package (no relative-import error).
case "$1" in
  status|doctor|backends|workflows|capabilities|update|setup|work)
    cd "$SCRIPT_DIR"
    exec python3 -m duck_agent.cli "$@"
    ;;
  *)
    true
    ;;
esac

case "$BACKEND" in
  grok-build)
    echo "Initializing Grok Build harness..."
    exec python3 "$SCRIPT_DIR/duck_agent/backends.py" start "$@"
    ;;
  hermes-compatible)
    echo "Initializing Hermes-compatible backend..."
    exec python3 "$SCRIPT_DIR/duck_agent/backends.py" start --backend hermes "$@"
    ;;
  prime-agent)
    echo "Initializing Prime Agent backend..."
    exec python3 "$SCRIPT_DIR/duck_agent/backends.py" start --backend prime-agent "$@"
    ;;
  *)
    echo -e "${RED}Error: Unknown backend: $BACKEND${NC}"
    echo ""
    echo "Available backends:"
    echo "  grok-build         - Primary harness with full Grok Build capabilities"
    echo "  hermes-compatible  - Hermes Agent compatibility mode"
    echo "  prime-agent        - Prime Intellect RLM-based agent"
    echo ""
    echo "Usage:"
    echo "  DUCK_AGENT_BACKEND=grok-build ./duck-agent"
    exit 1
    ;;
esac
