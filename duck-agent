#!/bin/bash
# Duck Agent Launcher
# Powered by Grok Build

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="${DUCK_AGENT_BACKEND:-grok-build}"

case "$BACKEND" in
  grok-build)
    exec python3 "$SCRIPT_DIR/run_agent.py" "$@"
    ;;
  hermes-compatible)
    exec python3 "$SCRIPT_DIR/run_agent.py" --backend hermes "$@"
    ;;
  prime-agent)
    exec "$SCRIPT_DIR/prime-agent.sh" "$@"
    ;;
  *)
    echo "Unknown backend: $BACKEND"
    echo "Available backends: grok-build, hermes-compatible, prime-agent"
    exit 1
    ;;
esac
